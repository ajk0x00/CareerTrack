# Application
PROJECT_NAME="FastAPI Service"
ENVIRONMENT="development"
DEBUG=false

# Server
HOST="0.0.0.0"
PORT=8000
API_V1_PREFIX="/api/v1"

# Documentation (leave empty in production to disable)
DOCS_URL="/docs"
REDOC_URL="/redoc"
OPENAPI_URL="/openapi.json"

# Security
ALLOWED_HOSTS='["*"]'
CORS_ORIGINS='["*"]'

# JWT Authentication
# In production, generate a secure 32+ byte key (e.g. `openssl rand -hex 32`)
JWT_SECRET_KEY="change-this-in-production-to-a-super-secret-key-at-least-32-bytes"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL)
# Production / External: Set to your managed DB host (RDS, Cloud SQL, Supabase, Neon, etc.)
# Local Docker DB (opt-in via --profile db): Set POSTGRES_SERVER="db"
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="careertrack"

# Alternatively, set full connection string directly (overrides above fields):
# DATABASE_URL="postgresql+asyncpg://<user>:<password>@<external-host>:5432/<dbname>"

# Database Connection Pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# Logging
LOG_LEVEL="INFO"

# Model Context Protocol (MCP)
# Option 1 (Recommended): Database-backed Client ID & Secret (generated per user in Settings -> MCP & API Keys)
CAREERTRACK_CLIENT_ID=""
CAREERTRACK_CLIENT_SECRET=""

# Option 2: Fallback JWT bearer token for local MCP clients that cannot set Authorization headers
CAREERTRACK_AUTH_TOKEN=""

# Large Language Model (LLM) Integration
LLM_API_KEY=""
LLM_BASE_URL="https://api.fireworks.ai/inference/v1"
LLM_MODEL="accounts/fireworks/models/glm-5p3"
LLM_TEMPERATURE=0.1

# LangSmith Observability & Tracing (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="careertrack"
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
